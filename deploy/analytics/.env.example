# Create .env with random secrets:   deploy/analytics/scripts/gen-analytics-env.sh
# or copy this file and fill every empty value yourself. The stack refuses to start while any
# of these is empty (there are no public defaults). Passwords must be URL-safe ([A-Za-z0-9._~-]).
# Garage key id must be GK + 24 hex chars; its secret 64 hex chars.
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
POSTGRES_PASSWORD=
LAKEKEEPER_DB_PASSWORD=
LAKEKEEPER_ENCRYPTION_KEY=
TRINO_ADMIN_PASSWORD=
TRINO_METABASE_PASSWORD=
TRINO_SHARED_SECRET=
METABASE_DB_PASSWORD=
METABASE_ENCRYPTION_KEY=
METABASE_ADMIN_PASSWORD=
HEC_TOKEN=
OTLP_BEARER_TOKEN=

# Metabase (optional)
# METABASE_ADMIN_EMAIL=admin@logthing.example
# METABASE_TRINO_TLS_MODE=pem
# METABASE_PORT=3000

# Timing
# COMMIT_INTERVAL_SECS=60
# LOGTHING_FLUSH_INTERVAL_SECS=60

# Images
# The defaults are 0.22.1. A tag older than 0.22.0 disables the typed OTLP/HEC pipeline (an older committer
# quarantines the new-shaped files); keep both images on the same release.
# LOGTHING_IMAGE=ghcr.io/mrmagooey/logthing:0.22.1
# COMMITTER_IMAGE=ghcr.io/mrmagooey/logthing-committer:0.22.1
# GARAGE_IMAGE=dxflrs/garage:v2.4.1
# POSTGRES_IMAGE=postgres:17
# LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:v0.13.6
# TRINO_IMAGE=trinodb/trino:483
# CERTGEN_IMAGE=alpine/openssl:3.5.9
# AUTHGEN_IMAGE=httpd:2.4.69-alpine
# BOOTSTRAP_IMAGE=python:3.12-slim
# METABASE_IMAGE=metabase/metabase:v0.64.1

# Bind address for Garage S3, Trino and Metabase. Defaults to loopback. Trino is HTTPS +
# password only; Lakekeeper is never published (see README "Network isolation").
# ANALYTICS_BIND_ADDR=127.0.0.1

# Metabase healthcheck retries (10 s apart). First start runs schema migrations; raise to ~180 on
# a slow host so `docker compose up --wait` does not give up early.
# METABASE_HEALTH_RETRIES=40

# Published host ports
# SYSLOG_UDP_PORT=514
# SYSLOG_TCP_PORT=601
# IPFIX_PORT=4739
# SFLOW_PORT=6343
# ZEEK_PORT=47760
# LOGTHING_HEALTH_PORT=5985   (HTTP: /health, OTLP, HEC)
# GARAGE_S3_PORT=3900
# TRINO_PORT=8443
