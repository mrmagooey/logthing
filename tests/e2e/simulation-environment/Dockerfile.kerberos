# Kerberos-enabled logthing for the wef-interop e2e. Real keytabs come from the compose KDC.
FROM rust:1.99-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies including Kerberos libraries and clang (required for bindgen)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libkrb5-dev \
    libclang-dev \
    clang \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo files first for better caching
COPY Cargo.toml Cargo.lock ./

# Copy source code
COPY src ./src

# Cargo.toml declares `tools/loadgen` as a workspace member (unrelated to
# this image — `default-members` keeps it out of the actual build) and a
# `[[bench]]` list under `benches/`, but cargo parses the whole manifest
# (workspace members + bench targets) before building anything, so both
# must exist in the build context even though nothing here runs them.
COPY tools ./tools
COPY benches ./benches

# Build release binary with Kerberos feature
RUN cargo build --release --features kerberos-auth

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies including Kerberos libraries
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libkrb5-3 \
    krb5-user \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /app/target/release/logthing /usr/local/bin/logthing

# Copy default config
COPY logthing.toml /etc/logthing/config.toml

# Create directory for certificates and keytabs
RUN mkdir -p /etc/logthing/certs

# Expose ports
EXPOSE 5985 5986 9090

# No image HEALTHCHECK: this runtime has no wget; compose probes the port instead.

# Run server
CMD ["logthing"]
